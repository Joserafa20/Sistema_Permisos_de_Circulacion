# ══════════════════════════════════════════════════════════════════
# Sistema de Permisos de Circulación — Pico y Placa
# Backend NestJS — Variables de Entorno
# ══════════════════════════════════════════════════════════════════
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NUNCA se sube al repositorio.
# ══════════════════════════════════════════════════════════════════

# ─── Aplicación ──────────────────────────────────────────────────
NODE_ENV=development
# Valores válidos: development | production | test

PORT=3001
# Puerto en el que escucha el servidor NestJS

FRONTEND_URL=http://localhost:3000
# URL del frontend. Se usa para configurar CORS.
# En producción: https://pyp.alcaldia.gov.co

# ─── Base de Datos (PostgreSQL 15) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyp_db
DB_USER=pyp_user
DB_PASSWORD=pyp_secret_cambia_en_produccion
DB_SCHEMA=public

# En producción usar un usuario con permisos mínimos necesarios.
# Ver: docs/PLAN_DESPLIEGUE.md §Base de Datos

# ─── Redis 7 ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Dejar vacío en desarrollo local sin contraseña.
# En producción: obligatorio con contraseña fuerte.

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion_minimo_32_caracteres_aleatorios
JWT_EXPIRES_IN=15m
# Tiempo de vida del Access Token. No cambiar sin revisar SECURITY.md.

JWT_REFRESH_SECRET=cambia_esto_tambien_en_produccion_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d
# Tiempo de vida del Refresh Token.

# ─── Storage (MinIO / S3-compatible) ─────────────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCS=pyp-documentos
STORAGE_BUCKET_PDFS=pyp-permisos
STORAGE_BUCKET_REPORTS=pyp-reportes
STORAGE_USE_SSL=false
# En producción: STORAGE_USE_SSL=true y credenciales seguras.

# ─── Email (SMTP) ────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@alcaldia.gov.co
MAIL_PASS=contrasena_smtp
MAIL_FROM="Alcaldía - Sistema PYP <noreply@alcaldia.gov.co>"
# Ver: docs/PLAN_DESPLIEGUE.md §Email

# ─── reCAPTCHA v3 ────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=obtener_en_google_recaptcha_admin
RECAPTCHA_MIN_SCORE=0.5
# Score mínimo aceptado (0.0 = bot, 1.0 = humano). Recomendado: 0.5

# ─── QR ──────────────────────────────────────────────────────────
QR_SECRET_SALT=cambia_esto_en_produccion_minimo_32_caracteres_aleatorios
# Salt para el hash SHA-256 del código QR. Ver: docs/DECISIONS.md ADR-009

# ─── URL Pública del Sistema ─────────────────────────────────────
PUBLIC_URL=https://pyp.alcaldia.gov.co
# Usada para construir la URL del QR: {PUBLIC_URL}/verificar/{codigo}

# ─── Seguridad ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# Mínimo: 12. No bajar en producción. Ver: docs/SECURITY.md
