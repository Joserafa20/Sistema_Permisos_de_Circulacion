# ══════════════════════════════════════════════════════════════════
# Sistema de Permisos de Circulación — Pico y Placa
# Backend NestJS — Variables de Entorno
# ══════════════════════════════════════════════════════════════════
# Copiar este archivo como .env y completar los valores reales.
# El archivo .env NUNCA se sube al repositorio.
# ══════════════════════════════════════════════════════════════════

# ─── Aplicación ──────────────────────────────────────────────────
NODE_ENV=development
# Valores válidos: development | production | test

PORT=3001
# Puerto en el que escucha el servidor NestJS

FRONTEND_URL=http://localhost:3000
# URL del frontend. Se usa para configurar CORS.
# En producción: https://pyp.alcaldia.gov.co

# ─── Base de Datos (PostgreSQL 15) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pyp_db
DB_USER=pyp_user
DB_PASSWORD=pyp_secret_cambia_en_produccion
DB_SCHEMA=public

# En producción usar un usuario con permisos mínimos necesarios.
# Ver: docs/PLAN_DESPLIEGUE.md §Base de Datos

# ─── Redis 7 ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Dejar vacío en desarrollo local sin contraseña.
# En producción: obligatorio con contraseña fuerte.

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion_minimo_32_caracteres_aleatorios
JWT_EXPIRES_IN=15m
# Tiempo de vida del Access Token. No cambiar sin revisar SECURITY.md.

JWT_REFRESH_SECRET=cambia_esto_tambien_en_produccion_minimo_32_caracteres
JWT_REFRESH_EXPIRES_IN=7d
# Tiempo de vida del Refresh Token.

# ─── Storage (MinIO / S3-compatible) ─────────────────────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_DOCS=pyp-documentos
STORAGE_BUCKET_PDFS=pyp-permisos
STORAGE_BUCKET_REPORTS=pyp-reportes
STORAGE_USE_SSL=false
# En producción: STORAGE_USE_SSL=true y credenciales seguras.

# ─── Email (SMTP) ────────────────────────────────────────────────
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@alcaldia.gov.co
MAIL_PASS=contrasena_smtp
MAIL_FROM="Alcaldía - Sistema PYP <noreply@alcaldia.gov.co>"
# Ver: docs/PLAN_DESPLIEGUE.md §Email

# ─── reCAPTCHA v3 ────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=obtener_en_google_recaptcha_admin
RECAPTCHA_MIN_SCORE=0.5
# Score mínimo aceptado (0.0 = bot, 1.0 = humano). Recomendado: 0.5

# ─── QR ──────────────────────────────────────────────────────────
QR_SECRET_SALT=cambia_esto_en_produccion_minimo_32_caracteres_aleatorios
# Salt para el hash SHA-256 del código QR. Ver: docs/DECISIONS.md ADR-009

# ─── URL Pública del Sistema ─────────────────────────────────────
PUBLIC_URL=https://pyp.alcaldia.gov.co
# Usada para construir la URL del QR: {PUBLIC_URL}/verificar/{codigo}

# ─── Seguridad ───────────────────────────────────────────────────
BCRYPT_ROUNDS=12
# Mínimo: 12. No bajar en producción. Ver: docs/SECURITY.md

# ─── Seeds iniciales ─────────────────────────────────────────────
# Usados por: npm run seed (backend/database/seeds/seed.ts)
# Idempotentes: re-ejecutar no duplica registros (ON CONFLICT DO NOTHING).

SEED_ADMIN_EMAIL=admin@alcaldia.gov.co
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_APELLIDO=Sistema
SEED_ADMIN_PASSWORD=Admin@Temporal2026!
# ⚠ CAMBIAR en producción. El admin DEBE cambiar la contraseña en el primer ingreso.
# La contraseña temporal expira el mismo día de creación (contrasena_expira_at = hoy).

SEED_ALCALDIA_NOMBRE=Alcaldía Municipal
# Nombre oficial de la alcaldía. Aparece en PDFs y portal.

SEED_MUNICIPIO_NOMBRE=Municipio Sede
SEED_MUNICIPIO_DEPARTAMENTO=Departamento
SEED_MUNICIPIO_CODIGO_DANE=00000
# Código DANE oficial del municipio: https://www.dane.gov.co/codigos-municipios

SEED_DEP_MOVILIDAD_NOMBRE=Secretaría de Movilidad
# Nombre de la dependencia responsable del trámite de permisos.

# ── Configuración Institucional (tabla configuracion_institucional) ─────────
# Usados por: npm run seed — sección configuracion_institucional
# Singleton: solo se crea un registro. Si ya existe, el seed no modifica nada.

SEED_CI_NOMBRE_ALCALDIA=Alcaldía Municipal de Ejemplo
SEED_CI_NIT=800.099.999-9
SEED_CI_CODIGO_DANE=00000
SEED_CI_DEPARTAMENTO=Departamento Ejemplo
SEED_CI_MUNICIPIO=Municipio Sede
SEED_CI_DIRECCION=Calle 10 # 5-20, Centro Administrativo
SEED_CI_TELEFONO=(000) 000-0000
SEED_CI_CORREO=contacto@alcaldia.gov.co
SEED_CI_SITIO_WEB=https://www.alcaldia.gov.co
# Sitio web es opcional. Dejar vacío si no aplica.

SEED_CI_ESCUDO_KEY=institucional/escudo-placeholder.png
# Ruta MinIO del escudo oficial. Actualizar una vez se configure el bucket.
# NUNCA exponer este valor en la API — usar URL firmada con TTL 5 min.

SEED_CI_LOGO_KEY=
# Ruta MinIO del logo (opcional). Dejar vacío si no hay logo separado del escudo.
