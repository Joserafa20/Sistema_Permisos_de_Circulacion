# ── Node / npm ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Husky ───────────────────────────────────────────────────────
# .husky/_/ es generado por husky init — no versionar
.husky/_/

# ── Compilados ──────────────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Variables de entorno ────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
# .env.example y .env.production.example SE SUBEN al repo (son plantillas)
# Los archivos de valores reales (.env.production, .env.docker) NUNCA se suben

# ── Cobertura de tests ──────────────────────────────────────────
coverage/

# ── IDE ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ──────────────────────────────────────────────────────
docker/volumes/
docker/.env.docker
docker/.env.production
docker/.env.staging
# Certificados SSL — NUNCA al repositorio
docker/nginx/ssl/*.pem
docker/nginx/ssl/*.crt
docker/nginx/ssl/*.key
# .env.example y .env.production.example SE SUBEN (son plantillas)

# ── Archivos de memoria de Claude (no son código del proyecto) ──
memory/

# ── Obsidian (notas personales, no son código del proyecto) ─────
.obsidian/
