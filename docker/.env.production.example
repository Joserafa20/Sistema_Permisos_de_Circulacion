# ══════════════════════════════════════════════════════════════════════════════
# Sistema de Permisos de Circulación — Variables de Producción
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCCIONES:
#   1. Copiar: cp .env.production.example .env.production
#   2. Completar TODOS los valores — no dejar ningún placeholder
#   3. Generar secretos: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   4. .env.production NUNCA se sube al repositorio (está en .gitignore)
#
# REGLAS DE SEGURIDAD:
#   - Todos los secretos deben ser únicos y diferentes entre sí
#   - JWT_SECRET y JWT_REFRESH_SECRET: mínimo 64 caracteres aleatorios
#   - QR_SECRET_SALT: mínimo 48 caracteres aleatorios
#   - Contraseñas de base de datos: mínimo 24 caracteres con símbolos
#   - Rotar todos los secretos ante cualquier sospecha de compromiso
# ══════════════════════════════════════════════════════════════════════════════

# ─── Versión de la aplicación ─────────────────────────────────────────────────
APP_VERSION=1.0.0

# ─── PostgreSQL 15 ────────────────────────────────────────────────────────────
POSTGRES_DB=picoyplaca_prod
POSTGRES_USER=picoyplaca_app
POSTGRES_PASSWORD=CAMBIAR_contraseña_postgresSQL_produccion_min24chars!

# ─── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIAR_contraseña_redis_produccion_min24chars!

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=pyp_minio_admin
MINIO_ROOT_PASSWORD=CAMBIAR_contraseña_minio_produccion_min24chars!
MINIO_BUCKET_DOCS=pyp-documentos-prod
MINIO_BUCKET_PDFS=pyp-permisos-prod
MINIO_BUCKET_REPORTS=pyp-reportes-prod

# ─── URLs públicas ────────────────────────────────────────────────────────────
# IMPORTANTE: usar HTTPS en producción
FRONTEND_URL=https://permisos.municipio.gov.co
PUBLIC_URL=https://permisos.municipio.gov.co

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIAR_secreto_jwt_produccion_minimo_64_caracteres_aleatorios_hexadecimales_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIAR_secreto_jwt_refresh_produccion_diferente_del_anterior_64chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email SMTP Producción ────────────────────────────────────────────────────
# Usar servidor SMTP institucional o servicio de terceros (SendGrid, AWS SES)
# NO apuntar a Mailpit en producción
MAIL_HOST=smtp.municipio.gov.co
MAIL_PORT=587
MAIL_USER=noreply@municipio.gov.co
MAIL_PASS=CAMBIAR_contrasena_smtp_produccion
MAIL_FROM=Alcaldía Municipal <noreply@municipio.gov.co>

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────────────
# Obtener en: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=CAMBIAR_recaptcha_secret_key_obtenida_en_google_admin
RECAPTCHA_MIN_SCORE=0.5

# ─── QR ───────────────────────────────────────────────────────────────────────
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRÍTICO: Si cambia este valor, todos los QR existentes dejan de ser válidos
QR_SECRET_SALT=CAMBIAR_salt_qr_produccion_minimo_48_caracteres_aleatorios_nunca_cambiar_despues

# ─── Seguridad ────────────────────────────────────────────────────────────────
# 12 en producción, 10 en testing (balance seguridad/performance)
BCRYPT_ROUNDS=12

# ─── Seed Configuración Institucional ─────────────────────────────────────────
# Datos que se insertan en la primera ejecución si la tabla está vacía.
# Pueden editarse desde el panel de administración después del primer despliegue.
SEED_CI_NOMBRE_ALCALDIA=Alcaldía Municipal de NombreMunicipio
SEED_CI_MUNICIPIO=NombreMunicipio
SEED_CI_DEPARTAMENTO=NombreDepartamento
SEED_CI_DIRECCION=Calle 1 # 1-01, Centro Administrativo
SEED_CI_TELEFONO=(600) 000 0000
SEED_CI_CORREO=alcaldia@municipio.gov.co
SEED_CI_SITIO_WEB=https://www.municipio.gov.co
SEED_CI_NIT=000000000-0
SEED_CI_CODIGO_DANE=00000
