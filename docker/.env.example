# ══════════════════════════════════════════════════════════════════════════════
# Sistema de Permisos de Circulación — Variables de Entorno Docker (Desarrollo)
# ══════════════════════════════════════════════════════════════════════════════
# INSTRUCCIONES:
#   1. Copiar este archivo: cp .env.example .env.docker
#   2. Editar .env.docker con valores reales (nunca compartir este archivo)
#   3. Levantar: docker compose --env-file .env.docker up --build
#
# El archivo .env.docker NUNCA se sube al repositorio (está en .gitignore).
# ══════════════════════════════════════════════════════════════════════════════

# ─── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL 15 ────────────────────────────────────────────────────────────
POSTGRES_DB=picoyplaca_dev
POSTGRES_USER=picoyplaca
POSTGRES_PASSWORD=cambia_esta_contrasena_postgres_local

# ─── Redis 7 ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=cambia_esta_contrasena_redis_local

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambia_esta_contrasena_minio_local
# Nombres de los buckets (se crean automáticamente al iniciar)
MINIO_BUCKET_DOCS=pyp-documentos-dev
MINIO_BUCKET_PDFS=pyp-permisos-dev
MINIO_BUCKET_REPORTS=pyp-reportes-dev
# Puertos expuestos en el host (cambiar si hay conflictos)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Backend NestJS ───────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# ─── Frontend Next.js ─────────────────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# reCAPTCHA: en desarrollo se acepta "disabled"
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=disabled

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANTE: Usar strings aleatorios de mínimo 32 caracteres.
# Generador: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_local_minimo_32_caracteres_aleatorios_aqui
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_tambien_local_minimo_32_caracteres_aqui
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email SMTP ───────────────────────────────────────────────────────────────
# En desarrollo puedes dejar estos valores como placeholder.
# El módulo de email solo se usa en Fase 4.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@alcaldia.gov.co
MAIL_PASS=placeholder_smtp_no_requerido_en_fase_0
MAIL_FROM=Alcaldía PYP <noreply@alcaldia.gov.co>

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────────────
# En desarrollo se acepta "disabled" — el guard lo omite en NODE_ENV=development.
# En producción: obtener en https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=disabled
RECAPTCHA_MIN_SCORE=0.5

# ─── QR ───────────────────────────────────────────────────────────────────────
# IMPORTANTE: String aleatorio de mínimo 32 caracteres.
QR_SECRET_SALT=cambia_esto_local_minimo_32_caracteres_para_hash_qr

# ─── URL Pública ──────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3000

# ─── Seguridad ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
