# ══════════════════════════════════════════════════════════════════════════════
# Sistema de Permisos de Circulación — Frontend Next.js — Variables de Entorno
# ══════════════════════════════════════════════════════════════════════════════
# Copiar este archivo como .env.local y completar los valores reales.
# El archivo .env.local NUNCA se sube al repositorio.
#
# Variables con prefijo NEXT_PUBLIC_ son expuestas al cliente (navegador).
# Variables sin prefijo solo están disponibles en el servidor (SSR/API routes).
# ══════════════════════════════════════════════════════════════════════════════

# ─── API Backend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# URL del backend NestJS. En producción: https://api.pyp.alcaldia.gov.co/api/v1

# ─── URL Pública del Sistema ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL del frontend. En producción: https://pyp.alcaldia.gov.co

# ─── reCAPTCHA v3 ────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=obtener_en_google_recaptcha_admin
# Site key pública de reCAPTCHA v3. Se implementa en Fase 5.
# Obtener en: https://www.google.com/recaptcha/admin
